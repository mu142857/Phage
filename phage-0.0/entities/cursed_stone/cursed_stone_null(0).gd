# =============================================================================
# Null(0)  —  空闲/停泊状态
# =============================================================================
# 不碰动画、不做决策。变身时主体会把状态切到这里「停泊」，
# 好让 Transformation 动画播完不被别的状态覆盖。
# =============================================================================
extends BasicState

func enter() -> void:
	if host != null:
		host.velocity = Vector2.ZERO

func process(_delta: float) -> void:
	pass

func exit() -> void:
	pass
